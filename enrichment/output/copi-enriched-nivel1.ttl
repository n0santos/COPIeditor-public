@prefix copi:       <https://www.inf.ufrgs.br/ontologies/copi/> .
@prefix iof-av:     <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix iof-constr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix obo:        <http://purl.obolibrary.org/obo/> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

<https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> a owl:Ontology ;
    rdfs:label "COPI Enriched — Nível 1"@en ;
    owl:imports <https://www.inf.ufrgs.br/ontologies/copi/copi-core> .

### Pumping Function  (COPI_0000066)
copi:COPI_0000066 a owl:Class ;
    rdfs:subClassOf iof-constr:DesignedFunction ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom copi:COPI_0000011 ] ;
    rdfs:label "pumping function"@en , "função de bombeamento"@pt-br ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Pump  (COPI_0000072)
copi:COPI_0000072 a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( iof-constr:Assembly
        [ a owl:Restriction ; owl:onProperty iof-constr:hasFunction ; owl:someValuesFrom copi:COPI_0000066 ]
    ) ] ;
    rdfs:subClassOf iof-constr:Assembly ;
    rdfs:label "pump"@en , "bomba"@pt-br ;
    iof-av:naturalLanguageDefinition "A pump is an assembly that bears the designed function of adding mechanical energy to fluid for pressurization and transport."@en ;
    iof-av:naturalLanguageDefinition "Uma bomba é um conjunto que possui a função projetada de adicionar energia mecânica ao fluido para pressurização e transporte."@pt-br ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Compression Function  (COPI_0000067)
copi:COPI_0000067 a owl:Class ;
    rdfs:subClassOf iof-constr:DesignedFunction ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom copi:COPI_0000012 ] ;
    rdfs:label "compression function"@en , "função de compressão"@pt-br ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Compressor  (COPI_0000073)
copi:COPI_0000073 a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( iof-constr:Assembly
        [ a owl:Restriction ; owl:onProperty iof-constr:hasFunction ; owl:someValuesFrom copi:COPI_0000067 ]
    ) ] ;
    rdfs:subClassOf iof-constr:Assembly ;
    rdfs:label "compressor"@en , "compressor"@pt-br ;
    iof-av:naturalLanguageDefinition "A compressor is an assembly that bears the designed function of compressing gases by adding mechanical energy to increase their pressure."@en ;
    iof-av:naturalLanguageDefinition "Um compressor é um conjunto que possui a função projetada de comprimir gases através da adição de energia mecânica para aumentar sua pressão."@pt-br ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Gas Absorption Function  (COPI_0000069)
copi:COPI_0000069 a owl:Class ;
    rdfs:subClassOf iof-constr:DesignedFunction ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom copi:COPI_0000013 ] ;
    rdfs:label "gas absorption function"@en , "função de absorção de gás"@pt-br ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Gas Absorber  (COPI_0000075)
copi:COPI_0000075 a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( copi:COPI_0000090
        [ a owl:Restriction ; owl:onProperty iof-constr:hasFunction ; owl:someValuesFrom copi:COPI_0000069 ]
    ) ] ;
    rdfs:subClassOf copi:COPI_0000090 ;
    rdfs:label "gas absorber"@en , "absorvedor de gás"@pt-br ;
    iof-av:naturalLanguageDefinition "An absorber is a pressure vessel that realizes an absorption function for selective mass transfer of components from a fluid mixture into an absorbent phase."@en ;
    iof-av:naturalLanguageDefinition "Um absorvedor é um vaso de pressão que realiza uma função de absorção para transferência seletiva de massa de componentes de uma mistura fluida para uma fase absorvente."@pt-br ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Temperature Sensing Function  (COPI_0000070)
copi:COPI_0000070 a owl:Class ;
    rdfs:subClassOf iof-constr:DesignedFunction ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom iof-constr:MeasurementProcess ] ;
    rdfs:label "temperature sensing function"@en , "função de sensoreamento de temperatura"@pt-br ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Temperature Sensor  (COPI_0000076)
copi:COPI_0000076 a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( copi:COPI_0000091
        [ a owl:Restriction ; owl:onProperty iof-constr:hasFunction ; owl:someValuesFrom copi:COPI_0000070 ]
    ) ] ;
    rdfs:subClassOf copi:COPI_0000091 ;
    rdfs:label "temperature sensor"@en , "sensor de temperatura"@pt-br ;
    iof-av:naturalLanguageDefinition "A temperature element is an instrument that bears a temperature sensing function."@en ;
    iof-av:naturalLanguageDefinition "Um elemento de temperatura é um instrumento que possui uma função de sensoreamento de temperatura."@pt-br ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Heat Transfer Function  (COPI_0000068)
copi:COPI_0000068 a owl:Class ;
    rdfs:subClassOf iof-constr:DesignedFunction ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom copi:COPI_0000089 ] ;
    rdfs:label "heat transfer function"@en , "função de transferência de calor"@pt-br ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Shell And Tube Heat Exchanger  (COPI_0000074)
copi:COPI_0000074 a owl:Class ;
    rdfs:subClassOf copi:COPI_0000092 ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty iof-constr:hasFunction ; owl:someValuesFrom copi:COPI_0000068 ] ;
    rdfs:label "shell and tube heat exchanger"@en , "trocador de calor de casco e tubos"@pt-br ;
    iof-av:naturalLanguageDefinition "A shell and tube heat exchanger is a heat exchanger that has a tube bundle spatially contained within a surrounding shell."@en ;
    iof-av:naturalLanguageDefinition "Um trocador de calor de casco e tubos é um trocador de calor que possui um feixe de tubos contido espacialmente dentro de um casco envolvente."@pt-br ;
    iof-av:firstOrderLogicAxiom "ShellAndTubeHeatExchanger(x) → HeatExchanger(x) ∧ ∃tb(TubeBundle(tb) ∧ hasComponentPartAtAllTimes(x,tb)) ∧ ∃s(Shell(s) ∧ hasComponentPartAtAllTimes(x,s) ∧ spatiallyContains(s,tb))"@en ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .
