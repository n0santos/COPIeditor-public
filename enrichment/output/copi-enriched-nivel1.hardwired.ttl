@prefix copi:       <https://www.inf.ufrgs.br/ontologies/copi/> .
@prefix iof-constr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix obo:        <http://purl.obolibrary.org/obo/> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

<https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> a owl:Ontology ;
    rdfs:label "COPI Enriched — Nível 1"@en ;
    owl:imports <https://www.inf.ufrgs.br/ontologies/copi/copi-core> .

### Pumping Function  (COPI_0000066)
copi:COPI_0000066 a owl:Class ;
    rdfs:subClassOf iof-constr:DesignedFunction ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom copi:COPI_0000011 ] ;
    rdfs:label "pumping function"@en ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Pump  (COPI_0000072)
copi:COPI_0000072 a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( iof-constr:Assembly
        [ a owl:Restriction ; owl:onProperty iof-constr:hasFunction ; owl:someValuesFrom copi:COPI_0000066 ]
    ) ] ;
    rdfs:subClassOf iof-constr:Assembly ;
    rdfs:label "pump"@en ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Compression Function  (COPI_0000067)
copi:COPI_0000067 a owl:Class ;
    rdfs:subClassOf iof-constr:DesignedFunction ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom copi:COPI_0000012 ] ;
    rdfs:label "compression function"@en ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Compressor  (COPI_0000073)
copi:COPI_0000073 a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( iof-constr:Assembly
        [ a owl:Restriction ; owl:onProperty iof-constr:hasFunction ; owl:someValuesFrom copi:COPI_0000067 ]
    ) ] ;
    rdfs:subClassOf iof-constr:Assembly ;
    rdfs:label "compressor"@en ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Gas Absorption Function  (COPI_0000069)
copi:COPI_0000069 a owl:Class ;
    rdfs:subClassOf iof-constr:DesignedFunction ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom copi:COPI_0000013 ] ;
    rdfs:label "gas absorption function"@en ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Gas Absorber  (COPI_0000075)
copi:COPI_0000075 a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( iof-constr:Assembly
        [ a owl:Restriction ; owl:onProperty iof-constr:hasFunction ; owl:someValuesFrom copi:COPI_0000069 ]
    ) ] ;
    rdfs:subClassOf iof-constr:Assembly ;
    rdfs:label "gas absorber"@en ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Temperature Sensing Function  (COPI_0000070)
copi:COPI_0000070 a owl:Class ;
    rdfs:subClassOf iof-constr:DesignedFunction ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom iof-constr:MeasurementProcess ] ;
    rdfs:label "temperature sensing function"@en ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .

### Temperature Sensor  (COPI_0000076)
copi:COPI_0000076 a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( iof-constr:MaterialArtifact
        [ a owl:Restriction ; owl:onProperty iof-constr:hasFunction ; owl:someValuesFrom copi:COPI_0000070 ]
    ) ] ;
    rdfs:subClassOf iof-constr:MaterialArtifact ;
    rdfs:label "temperature sensor"@en ;
    rdfs:isDefinedBy <https://www.inf.ufrgs.br/ontologies/copi/copi-enriched> .
