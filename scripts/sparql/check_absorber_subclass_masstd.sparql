# Nível 1 classification: GasAbsorber ⊑ MassTransferDevice (must hold)
# Returns a row (violation) if the entailment is ABSENT from the reasoned graph.
PREFIX copi: <https://www.inf.ufrgs.br/ontologies/copi/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?violation WHERE {
  FILTER NOT EXISTS {
    copi:COPI_0000075 rdfs:subClassOf+ copi:COPI_0000018 .
  }
  BIND("GasAbsorber (COPI_0000075) is not a subClassOf MassTransferDevice (COPI_0000018)" AS ?violation)
}
