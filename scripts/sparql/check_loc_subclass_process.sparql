# ODR-009 entailment: LossOfContainment ⊑ bfo:Process
# Returns rows when the entailment is ABSENT (failure condition).
PREFIX copi: <https://www.inf.ufrgs.br/ontologies/copi/>
PREFIX bfo:  <http://purl.obolibrary.org/obo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?missing WHERE {
  BIND("LossOfContainment (COPI_0000015) ⊑ bfo:Process" AS ?missing)
  FILTER NOT EXISTS {
    copi:COPI_0000015 rdfs:subClassOf* bfo:BFO_0000015 .
  }
}
