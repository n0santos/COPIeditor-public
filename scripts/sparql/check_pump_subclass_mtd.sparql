# Nível 1 classification: Pump ⊑ MomentumTransferDevice (must hold)
# Returns a row (violation) if the entailment is ABSENT from the reasoned graph.
PREFIX copi: <https://www.inf.ufrgs.br/ontologies/copi/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?violation WHERE {
  FILTER NOT EXISTS {
    copi:COPI_0000072 rdfs:subClassOf+ copi:COPI_0000016 .
  }
  BIND("Pump (COPI_0000072) is not a subClassOf MomentumTransferDevice (COPI_0000016)" AS ?violation)
}
