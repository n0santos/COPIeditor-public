# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Anthropic API ──────────────────────────────────────────────────────────────
# Required for the axiomatization workbench (/enrich/).
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Keycloak auth ──────────────────────────────────────────────────────────────
# Provided by infra team. Client must be "confidential" type in Keycloak.
# KEYCLOAK_URL=https://auth.example.com
# KEYCLOAK_REALM=my-realm
# KEYCLOAK_CLIENT_ID=copieditor
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_REDIRECT_URI=https://your-domain/auth/callback
# SESSION_SECRET=  # generate with: openssl rand -hex 32

# ── Web server ─────────────────────────────────────────────────────────────────
# Port exposed by uvicorn / Docker Compose (default: 8765)
# PORT=8765
